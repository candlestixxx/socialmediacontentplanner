{
  "name": "contentcommand-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "jest",
    "test:web": "turbo run test --filter=web",
    "test:api": "turbo run test --filter=api"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "metro": "0.81.5",
    "metro-config": "0.81.5",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "react-native": "0.76.7",
    "metro": "0.81.5",
    "metro-config": "0.81.5"
  }
}
